@startuml classes
!pragma layout smetana
!include estilo.iuml
title ChegaAí — Diagrama de classes do domínio
hide empty members
skinparam linetype ortho

abstract class Usuario {
  - id : UUID
  - nome : String
  - email : String
  - cpf : String [0..1]
  - senhaHash : String
  - dataNascimento : LocalDate
  - honraMedia : BigDecimal
  - honraInicial : BigDecimal
  - descontoHonraAcumulado : BigDecimal
  - statusUsuario : StatusUsuario
  - suspensoAte : OffsetDateTime [0..1]
  - qtdDenunciasValidadas : int
  + {abstract} getPapelSistema() : PapelSistema
  + estaAtivo(agora) : boolean
  + contaEncerrada() : boolean
  + exigirContaAtiva(agora)
  + podeCriarEvento(honraMinima) : boolean
  + qualificaEmbaixador(limite) : boolean
  + primeiroNome() : String
}
class Participante
class Embaixador
class Administrador
Usuario <|-- Participante
Usuario <|-- Embaixador
Usuario <|-- Administrador
note right of Usuario
  Herança em tabela única
  (coluna papel_sistema)
end note

class Evento {
  - id : UUID
  - titulo : String
  - descricao : String
  - dataHoraRealizacao : OffsetDateTime
  - limiteParticipantes : int
  - statusEvento : StatusEvento
  - travado : boolean
  + contarConfirmados() : long
  + possuiVaga() : boolean
  + concluir(agora)
  + cancelar()
  + travar()
  + destravar()
}
class Inscricao {
  - id : UUID
  - dataHoraSolicitacao : OffsetDateTime
  - ordemEntrada : long
  - statusInscricao : StatusInscricao
  - compareceu : boolean
  - descontoHonraAplicado : BigDecimal
  + confirmar()
  + cancelar()
  + registrarPresenca()
  + registrarAusencia()
  + marcarAusente()
  + estaConfirmada() : boolean
  + estaEmFilaDeEspera() : boolean
}
class Comentario {
  - id : UUID
  - texto : String
  - dataHoraComentario : OffsetDateTime
  + pertenceAo(idUsuario) : boolean
}
class Avaliacao {
  - id : UUID
  - nota : int {1..5}
  - comentarioOpcional : String
  - dataHoraAvaliacao : OffsetDateTime
  + validar()
  + ehAutoAvaliacao() : boolean
}
class Categoria {
  - id : UUID
  - nome : String
  - descricao : String
  - ativa : boolean
  + ativar()
  + inativar()
}
class Endereco {
  - id : UUID
  - cep : String
  - logradouro : String
  - numero : String
  - complemento : String
  - bairro : String
  - cidade : String
  - estado : String
  + formatarEnderecoCompleto() : String
}
class Denuncia {
  - id : UUID
  - motivo : String
  - detalhes : String
  - dataHoraDenuncia : OffsetDateTime
  - statusDenuncia : StatusDenuncia
  + iniciarAnalise()
  + classificarComoProcedente()
  + classificarComoImprocedente()
  + encerrar()
  + estaPendente() : boolean
}
class Penalidade {
  - id : UUID
  - tipoPenalidade : TipoPenalidade
  - motivo : String
  - dataInicio : LocalDate
  - dataFim : LocalDate
  - ativa : boolean
  + encerrar()
  + estaAtiva() : boolean
  + ehBanimentoPermanente() : boolean
}
note bottom of Denuncia
  Denúncia e Penalidade estão no modelo
  e no banco, mas ainda não têm rotas na API.
end note

Usuario "1 organizador" -- "0..*" Evento : organiza >
Evento "0..*" --> "1" Categoria
Evento "0..*" --> "1" Endereco
Evento "1" *-- "0..*" Inscricao
Usuario "1" -- "0..*" Inscricao : solicita >
Evento "1" *-- "0..*" Comentario
Usuario "1 autor" -- "0..*" Comentario
Evento "1" *-- "0..*" Avaliacao
Usuario "1 avaliador" -- "0..*" Avaliacao
Usuario "1 avaliado" -- "0..*" Avaliacao
Denuncia "0..*" --> "1 denunciante" Usuario
Denuncia "0..*" --> "1 denunciado" Usuario
Denuncia "0..*" --> "0..1" Evento
Penalidade "0..*" --> "1 penalizado" Usuario
Penalidade "0..*" --> "1 adminAplicador" Usuario

enum PapelSistema {
  PARTICIPANTE
  EMBAIXADOR
  ADMINISTRADOR
}
enum StatusUsuario {
  ATIVO
  SUSPENSO
  BANIDO
  EXCLUIDO
}
enum StatusEvento {
  ATIVO
  CANCELADO
  CONCLUIDO
}
enum StatusInscricao {
  SOLICITADA
  CONFIRMADA
  CANCELADA
  AUSENTE
}
enum StatusDenuncia {
  ABERTA
  EM_ANALISE
  VALIDADA
  REJEITADA
  ENCERRADA
}
enum TipoPenalidade {
  ADVERTENCIA
  SUSPENSAO
  BANIMENTO
}
note bottom of StatusInscricao
  SOLICITADA = na fila de espera,
  atendida pela ordem de entrada
end note
note bottom of StatusUsuario
  SUSPENSO com suspensoAte vence sozinho
  (3 cancelamentos tardios em 30 dias
  suspendem por 7). EXCLUIDO = a pessoa
  excluiu a conta e os dados pessoais
  foram apagados.
end note
@enduml
